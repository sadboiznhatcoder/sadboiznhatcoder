# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN N.A.T AUTOMATION
# Tạo bản sao file này thành .env.local để chạy trên môi trường Development
# ============================================================

# --- Supabase Database & Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service Role Key (Chỉ dùng server-side để bypass RLS khi tạo đơn hàng an toàn)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Trợ lý ảo AI Chatbot (Groq & Google Gemini) ---
# Primary AI Provider: Groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI Provider: Google GenAI (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Bảo mật Admin Dashboard ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_32_character_secret_key_here
